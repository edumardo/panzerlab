    {
      "id": "d65250b-p083-para01",
      "text": {
        "de": {
          "plain": "Die beiden Halteschrauben des Kupplungsdeckels nachziehen.",
          "runs": [
            {
              "text": "Die beiden Halteschrauben des Kupplungsdeckels nachziehen.",
              "bold": false
            }
          ]
        },
        "en-GB": {
          "plain": "Retighten the two retaining screws of the clutch cover.",
          "runs": [
            {
              "text": "Retighten the two retaining screws of the clutch cover.",
              "bold": false
            }
          ]
        },
        "es-ES": {
          "plain": "Reapretar los dos tornillos de sujeción de la tapa de embrague.",
          "runs": [
            {
              "text": "Reapretar los dos tornillos de sujeción de la tapa de embrague.",
              "bold": false
            }
          ]
        }
      }
    },
    {
      "id": "d65250b-p083-para02",
      "text": {
        "de": {
          "plain": "Kupplungswelle ausziehen.",
          "runs": [
            {
              "text": "Kupplungswelle ausziehen.",
              "bold": false
            }
          ]
        },
        "en-GB": {
          "plain": "Withdraw the clutch shaft.",
          "runs": [
            {
              "text": "Withdraw the clutch shaft.",
              "bold": false
            }
          ]
        },
        "es-ES": {
          "plain": "Extraer el eje de embrague.",
          "runs": [
            {
              "text": "Extraer el eje de embrague.",
              "bold": false
            }
          ]
        }
      }
    },
    {
      "id": "d65250b-p083-para03",
      "text": {
        "de": {
          "plain": "Mit Kettenbolzen die Kupplungstreibscheiben auf Mitte richten.",
          "runs": [
            {
              "text": "Mit Kettenbolzen die Kupplungstreibscheiben auf Mitte richten.",
              "bold": false
            }
          ]
        },
        "en-GB": {
          "plain": "Centre the clutch driving discs using a chain bolt.",
          "runs": [
            {
              "text": "Centre the clutch driving discs using a chain bolt.",
              "bold": false
            }
          ]
        },
        "es-ES": {
          "plain": "Centrar los discos motrices del embrague con un perno de cadena.",
          "runs": [
            {
              "text": "Centrar los discos motrices del embrague con un perno de cadena.",
              "bold": false
            }
          ]
        }
      }
    },
    {
      "id": "d65250b-p083-para04",
      "text": {
        "de": {
          "plain": "Prüfen, ob sich Kupplungswelle bis zum hinteren Kugellager einführen läßt.",
          "runs": [
            {
              "text": "Prüfen, ob sich Kupplungswelle bis zum hinteren Kugellager einführen läßt.",
              "bold": false
            }
          ]
        },
        "en-GB": {
          "plain": "Check that the clutch shaft can be inserted as far as the rear ball bearing.",
          "runs": [
            {
              "text": "Check that the clutch shaft can be inserted as far as the rear ball bearing.",
              "bold": false
            }
          ]
        },
        "es-ES": {
          "plain": "Comprobar que el eje de embrague pueda introducirse hasta el rodamiento de bolas trasero.",
          "runs": [
            {
              "text": "Comprobar que el eje de embrague pueda introducirse hasta el rodamiento de bolas trasero.",
              "bold": false
            }
          ]
        }
      }
