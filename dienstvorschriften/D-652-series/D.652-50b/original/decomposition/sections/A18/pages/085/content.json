  "paragraphs": [
    {
      "id": "d65250b-p085-para01",
      "text": {
        "de": {
          "plain": "Das Kupplungsgehäuse mit 17-SW-Steckschlüssel mit dem Motor verschrauben.",
          "runs": [
            {
              "text": "Das Kupplungsgehäuse mit 17-SW-Steckschlüssel mit dem Motor verschrauben.",
              "bold": false
            }
          ]
        },
        "en-GB": {
          "plain": "Bolt the clutch housing to the engine with a 17 mm A/F socket spanner.",
          "runs": [
            {
              "text": "Bolt the clutch housing to the engine with a 17 mm A/F socket spanner.",
              "bold": false
            }
          ]
        },
        "es-ES": {
          "plain": "Atornillar la carcasa del embrague al motor con una llave de vaso de 17 mm de entrecaras.",
          "runs": [
            {
              "text": "Atornillar la carcasa del embrague al motor con una llave de vaso de 17 mm de entrecaras.",
              "bold": false
            }
          ]
        }
      }
    },
    {
      "id": "d65250b-p085-para02",
      "text": {
        "de": {
          "plain": "Den Kugellagerabstandsring mit dem Bund gegen die Nuten auf die Kupplungswelle schieben.",
          "runs": [
            {
              "text": "Den Kugellagerabstandsring mit dem Bund gegen die Nuten auf die Kupplungswelle schieben.",
              "bold": false
            }
          ]
        },
        "en-GB": {
          "plain": "Slide the ball-bearing spacer ring onto the clutch shaft with the collar facing the grooves.",
          "runs": [
            {
              "text": "Slide the ball-bearing spacer ring onto the clutch shaft with the collar facing the grooves.",
              "bold": false
            }
          ]
        },
        "es-ES": {
          "plain": "Deslizar el anillo distanciador del rodamiento de bolas sobre el eje de embrague con el collar orientado hacia las ranuras.",
          "runs": [
            {
              "text": "Deslizar el anillo distanciador del rodamiento de bolas sobre el eje de embrague con el collar orientado hacia las ranuras.",
              "bold": false
            }
          ]
        }
      }
    }
  ],
