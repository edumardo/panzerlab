  "paragraphs": [
    {
      "id": "d65250b-p099-para01",
      "text": {
        "de": {
          "plain": "Die Schrauben der Geschützbefestigung entsichern und mit 41-SW-Maul- oder -Steckschlüssel herausschrauben.",
          "runs": [
            {
              "text": "Die Schrauben der Geschützbefestigung entsichern und mit 41-SW-Maul- oder -Steckschlüssel herausschrauben.",
              "bold": false
            }
          ]
        },
        "en-GB": {
          "plain": "Unlock the bolts of the gun mounting and unscrew them using a 41 mm open-end or socket wrench.",
          "runs": [
            {
              "text": "Unlock the bolts of the gun mounting and unscrew them using a 41 mm open-end or socket wrench.",
              "bold": false
            }
          ]
        },
        "es-ES": {
          "plain": "Desasegurar los tornillos de fijación del cañón y desenroscarlos con una llave de boca o de tubo de 41 mm.",
          "runs": [
            {
              "text": "Desasegurar los tornillos de fijación del cañón y desenroscarlos con una llave de boca o de tubo de 41 mm.",
              "bold": false
            }
          ]
        }
      }
    },
    {
      "id": "d65250b-p099-para02",
      "text": {
        "de": {
          "plain": "Geschütz mit Seil und Hebevorrichtung herausheben.",
          "runs": [
            {
              "text": "Geschütz mit Seil und Hebevorrichtung herausheben.",
              "bold": false
            }
          ]
        },
        "en-GB": {
          "plain": "Lift the gun out using a rope and lifting gear.",
          "runs": [
            {
              "text": "Lift the gun out using a rope and lifting gear.",
              "bold": false
            }
          ]
        },
        "es-ES": {
          "plain": "Extraer el cañón con cuerda y dispositivo de elevación.",
          "runs": [
            {
              "text": "Extraer el cañón con cuerda y dispositivo de elevación.",
              "bold": false
            }
          ]
        }
      }
    }
  ],
