  "paragraphs": [
    {
      "id": "d65250b-p076-para01",
      "text": {
        "de": {
          "plain": "Mit 6-mm-Bohrer den Senkkopf der Nieten anbohren.",
          "runs": [
            {
              "text": "Mit 6-mm-Bohrer den Senkkopf der Nieten anbohren.",
              "bold": false
            }
          ]
        },
        "en-GB": {
          "plain": "Using a 6 mm drill bit, drill out the countersunk head of the rivets.",
          "runs": [
            {
              "text": "Using a 6 mm drill bit, drill out the countersunk head of the rivets.",
              "bold": false
            }
          ]
        },
        "es-ES": {
          "plain": "Con una broca de 6 mm, taladrar la cabeza avellanada de los remaches.",
          "runs": [
            {
              "text": "Con una broca de 6 mm, taladrar la cabeza avellanada de los remaches.",
              "bold": false
            }
          ]
        }
      }
    },
    {
      "id": "d65250b-p076-para02",
      "text": {
        "de": {
          "plain": "Kupplungsscheibe mit dem Niet auf eine Mutter legen.",
          "runs": [
            {
              "text": "Kupplungsscheibe mit dem Niet auf eine Mutter legen.",
              "bold": false
            }
          ]
        },
        "en-GB": {
          "plain": "Place the clutch disc, rivet down, onto a nut.",
          "runs": [
            {
              "text": "Place the clutch disc, rivet down, onto a nut.",
              "bold": false
            }
          ]
        },
        "es-ES": {
          "plain": "Colocar el disco de embrague, con el remache hacia abajo, sobre una tuerca.",
          "runs": [
            {
              "text": "Colocar el disco de embrague, con el remache hacia abajo, sobre una tuerca.",
              "bold": false
            }
          ]
        }
      }
    },
    {
      "id": "d65250b-p076-para03",
      "text": {
        "de": {
          "plain": "Mit Hammer und Dorn die Nieten ausschlagen.",
          "runs": [
            {
              "text": "Mit Hammer und Dorn die Nieten ausschlagen.",
              "bold": false
            }
          ]
        },
        "en-GB": {
          "plain": "Drive out the rivets using a hammer and drift.",
          "runs": [
            {
              "text": "Drive out the rivets using a hammer and drift.",
              "bold": false
            }
          ]
        },
        "es-ES": {
          "plain": "Extraer los remaches golpeando con martillo y botador.",
          "runs": [
            {
              "text": "Extraer los remaches golpeando con martillo y botador.",
              "bold": false
            }
          ]
        }
      }
    }
  ],
